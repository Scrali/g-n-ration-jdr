# Copier ce fichier en .env.local et compléter.
# Ne JAMAIS mettre la clé service_role ici : tout ce qui commence par VITE_ est public.

# URL du projet Supabase (Project Settings → API)
VITE_SUPABASE_URL=
# Clé publique "anon" / "publishable" (protégée par les politiques RLS)
VITE_SUPABASE_ANON_KEY=

# Chemin de base pour GitHub Pages, ex. /panier-malin-suisse/ (laisser vide en local)
VITE_BASE_PATH=
